#!/usr/bin/env bash
set -euo pipefail

exec > >(tee /var/log/openvpn-access-server-bootstrap.log | logger -t openvpn-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive

retry() {
  local attempts=30
  local delay=10
  local number=1

  until "$@"; do
    if [ "$number" -ge "$attempts" ]; then
      echo "Command failed after $attempts attempts: $*" >&2
      return 1
    fi

    echo "Command failed. Retrying in $delay seconds ($number/$attempts): $*" >&2
    number=$((number + 1))
    sleep "$delay"
  done
}

retry apt-get update
retry apt-get install -y ca-certificates wget gnupg net-tools jq

install -d -m 0755 /etc/apt/keyrings
wget -qO /etc/apt/keyrings/as-repository.asc https://packages.openvpn.net/as-repo-public.asc

echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/as-repository.asc] http://packages.openvpn.net/as/debian noble main" \
  > /etc/apt/sources.list.d/openvpn-as-repo.list

retry apt-get update
retry apt-get install -y openvpn-as

systemctl enable openvpnas
systemctl restart openvpnas

SACLI="/usr/local/openvpn_as/scripts/sacli"
SERVER_ADDRESS='${server_address}'

for _ in $(seq 1 60); do
  if [ -x "$SACLI" ] && systemctl is-active --quiet openvpnas; then
    break
  fi
  sleep 5
done

if [ ! -x "$SACLI" ]; then
  echo "sacli was not found after installation." >&2
  exit 1
fi

if [ -n "$SERVER_ADDRESS" ]; then
  "$SACLI" --key "host.name" --value "$SERVER_ADDRESS" ConfigPut
  "$SACLI" start
fi

install -d -m 0755 /etc/motd.d

cat >/etc/motd.d/openvpn-access-server <<MOTD
OpenVPN Access Server is installed.
Admin UI: https://$SERVER_ADDRESS/admin/
Client UI: https://$SERVER_ADDRESS/
Bootstrap log: /var/log/openvpn-access-server-bootstrap.log
Initial configuration log: /usr/local/openvpn_as/init.log
MOTD

${additional_userdata}
